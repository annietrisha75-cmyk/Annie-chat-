<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <script src="/socket.io/socket.io.js"></script>
  <style>
    * { box-sizing: border-box; font-family: sans-serif; margin: 0; padding: 0; }
    body { display: flex; height: 100vh; background: #121212; color: #fff; }
    #sidebar { width: 300px; border-right: 1px solid #333; padding: 15px; }
    #main { flex: 1; display: flex; flex-direction: column; }
    .visitor-item { padding: 10px; cursor: pointer; border-bottom: 1px solid #222; display: flex; justify-content: space-between; }
    .visitor-item.active { background: #222; }
    .status-dot { width: 10px; height: 10px; border-radius: 50%; background: #555; display: inline-block; }
    .status-dot.online { background: #00ff66; }
    #chat-box { flex: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; gap: 8px; }
    .msg { max-width: 60%; padding: 8px 12px; border-radius: 6px; font-size: 14px; }
    .msg.sent { align-self: flex-end; background: #007bff; }
    .msg.received { align-self: flex-start; background: #333; }
    #controls { padding: 15px; border-top: 1px solid #333; display: flex; gap: 10px; }
    input[type="text"] { flex: 1; padding: 10px; border-radius: 4px; border: 1px solid #444; background: #222; color: #fff; }
    button { padding: 10px 15px; background: #007bff; border: none; color: #fff; border-radius: 4px; cursor: pointer; }
    button:disabled { background: #444; cursor: not-allowed; }
    #call-bar { padding: 10px 15px; background: #1e1e1e; display: flex; justify-content: space-between; align-items: center; }
  </style>
</head>
<body>

  <div id="sidebar">
    <h3>Visitors</h3>
    <div id="visitor-list" style="margin-top:15px;"></div>
  </div>

  <div id="main">
    <div id="call-bar">
      <span id="active-visitor-title">Select a visitor</span>
      <div>
        <button id="call-btn" disabled onclick="startCall()">Call Visitor</button>
        <button id="end-btn" style="background:#dc3545; display:none;" onclick="endCall()">End Call</button>
      </div>
    </div>

    <div id="chat-box"></div>

    <div id="controls">
      <input type="text" id="msg-input" placeholder="Type a message..." disabled />
      <button id="send-btn" disabled onclick="sendMessage()">Send</button>
    </div>
  </div>

<script>
  const socket = io();
  let selectedVisitor = null;
  let peerConnection = null;
  let localStream = null;

  const rtcConfig = { iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] };

  socket.emit('register', { role: 'admin', email: 'admin' });

  socket.on('visitor_list', (visitors) => renderVisitors(visitors));
  socket.on('visitor_list_update', () => socket.emit('register', { role: 'admin', email: 'admin' }));

  function renderVisitors(list) {
    const container = document.getElementById('visitor-list');
    container.innerHTML = '';
    list.forEach(v => {
      const div = document.createElement('div');
      div.className = `visitor-item ${selectedVisitor === v.email ? 'active' : ''}`;
      div.innerHTML = `<span>${v.email}</span><span class="status-dot ${v.online ? 'online' : ''}"></span>`;
      div.onclick = () => selectVisitor(v.email);
      container.appendChild(div);
    });
  }

  function selectVisitor(email) {
    selectedVisitor = email;
    document.getElementById('active-visitor-title').innerText = email;
    document.getElementById('call-btn').disabled = false;
    document.getElementById('msg-input').disabled = false;
    document.getElementById('send-btn').disabled = false;
    
    // Fetch stored chat history from DB
    socket.emit('get_history', { visitorEmail: email });
  }

  socket.on('history_data', ({ visitorEmail, history }) => {
    if (visitorEmail !== selectedVisitor) return;
    const box = document.getElementById('chat-box');
    box.innerHTML = '';
    history.forEach(appendMessage);
  });

  function sendMessage() {
    const input = document.getElementById('msg-input');
    const text = input.value.trim();
    if (!text || !selectedVisitor) return;

    socket.emit('send_message', { sender: 'admin', receiver: selectedVisitor, text });
    input.value = '';
  }

  socket.on('receive_message', (msg) => {
    if (msg.sender === selectedVisitor || msg.receiver === selectedVisitor) {
      appendMessage(msg);
    }
  });

  socket.on('message_sent', (msg) => {
    if (msg.receiver === selectedVisitor) appendMessage(msg);
  });

  function appendMessage(msg) {
    const box = document.getElementById('chat-box');
    const div = document.createElement('div');
    div.className = `msg ${msg.sender === 'admin' ? 'sent' : 'received'}`;
    div.innerText = msg.text;
    box.appendChild(div);
    box.scrollTop = box.scrollHeight;
  }

  // --- Safe WebRTC Handling ---
  async function startCall() {
    if (!selectedVisitor) return;
    document.getElementById('call-btn').style.display = 'none';
    document.getElementById('end-btn').style.display = 'inline-block';

    peerConnection = new RTCPeerConnection(rtcConfig);

    peerConnection.onicecandidate = (e) => {
      if (e.candidate) {
        socket.emit('webrtc_ice_candidate', { targetEmail: selectedVisitor, candidate: e.candidate });
      }
    };

    const offer = await peerConnection.createOffer();
    await peerConnection.setLocalDescription(offer);

    socket.emit('webrtc_offer', { targetEmail: selectedVisitor, offer });
  }

  socket.on('webrtc_answer', async ({ answer }) => {
    if (peerConnection) {
      await peerConnection.setRemoteDescription(new RTCSessionDescription(answer));
    }
  });

  // End Call & Full Cleanup Routine (Prevents Freezing/Hanging)
  function endCall() {
    if (selectedVisitor) {
      socket.emit('end_call', { targetEmail: selectedVisitor });
    }
    cleanupCall();
  }

  socket.on('call_ended', () => cleanupCall());

  function cleanupCall() {
    if (localStream) {
      localStream.getTracks().forEach(track => track.stop());
      localStream = null;
    }
    if (peerConnection) {
      peerConnection.ontrack = null;
      peerConnection.onicecandidate = null;
      peerConnection.close();
      peerConnection = null;
    }
    document.getElementById('call-btn').style.display = 'inline-block';
    document.getElementById('end-btn').style.display = 'none';
  }
</script>
</body>
</html>
